{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "webui-theme",
  "description": "Allow the embedded local WebUI to persist its theme preference.",
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "windows": ["main"],
  "permissions": ["allow-console-set-theme-mode", "allow-open-external-url"]
}
